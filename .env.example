# ── Instagram data source (RapidAPI) ─────────────────────────────────────────
# Sign up at rapidapi.com, subscribe to a supported Instagram API, and paste
# the key here. Without it the API/collector still run but live collection
# returns a 502 (use scripts/seed_demo.py to explore with synthetic data).
#
# Supported hosts (the request shape is picked from RAPIDAPI_HOST):
#   instagram120.p.rapidapi.com          (default)
#   instagram-looter2.p.rapidapi.com
RAPIDAPI_KEY=
RAPIDAPI_HOST=instagram120.p.rapidapi.com

# ── Storage ──────────────────────────────────────────────────────────────────
# SQLite by default; point at Postgres for production, e.g.
# postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./insta_monitor.db

# ── Scheduler ────────────────────────────────────────────────────────────────
COLLECT_INTERVAL_MINUTES=360
ENABLE_SCHEDULER=true

# ── Analysis defaults ────────────────────────────────────────────────────────
DEFAULT_FREQ=1D
DEFAULT_FORECAST_HORIZON=7

# ── Demo data ────────────────────────────────────────────────────────────────
# Seed synthetic demo accounts on startup when the DB is empty. Handy on hosts
# without shell access (e.g. Render free tier).
SEED_DEMO_ON_STARTUP=false
